# ──────────────────────────────────────────────────────────────────────────────
# VIBEMATCH — Backend Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────
# COPY THIS FILE TO .env AND FILL IN THE VALUES BEFORE RUNNING IN PRODUCTION.
# Never commit .env to source control.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong random key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
VIBEMATCH_SECRET_KEY=vibematch-change-this-before-production-use-a-strong-random-key

# Token lifetime in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In development you can use * but for production specify exact domains.
VIBEMATCH_CORS_ORIGINS=*

# ── Music APIs ────────────────────────────────────────────────────────────────
# Deezer API: NO KEY REQUIRED. Free, high rate limits. Used for artist/track search.
# Last.fm API: FREE key for genre tags. Get one at https://www.last.fm/api/account/create
# Leave blank to skip genre tag enrichment (Deezer search still works without it).
LASTFM_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local development. Switch to PostgreSQL URL for production:
#   DATABASE_URL=postgresql://user:password@host:5432/vibematch
DATABASE_URL=sqlite:///./vibematch.db
