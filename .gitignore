# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.Python

# ── Environment & Secrets ─────────────────────────────────────────────────────
# NEVER commit real secrets. .env holds the JWT secret key and DB credentials.
.env
.env.local
.env.*.local
*.env

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite dev DB — do not commit actual data files
*.db
*.sqlite
*.sqlite3

# ── Local seed / PII dumps — never commit ─────────────────────────────────────
proxy_seed_data.json
proxy_USER_DATA
seed_*.json

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
uvicorn.*.log
expo.*.log

# ── Test / Coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Node (mobile + website) ───────────────────────────────────────────────────
mobile/node_modules/
mobile/.expo/
mobile/.expo-shared/
mobile/dist/
mobile/web-build/
website/node_modules/
website/dist/
website/.vite/
**/.expo/
**/node_modules/
**/dist/

# ── Docker — do not commit local overrides / volumes ──────────────────────────
docker-compose.override.yml
.docker/
*.tar
*.tar.gz
vibematch-data/

# ── Expo / EAS — local credentials ────────────────────────────────────────────
*.jks
*.p8
*.p12
*.key
*.mobileprovision
credentials.json
eas.json.local

# ── Misc ──────────────────────────────────────────────────────────────────────
.wslconfig
*.tmp
*.temp
