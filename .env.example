# Copy to .env and fill in. Never commit .env.
VIBEMATCH_ENV=development
# python -c "import secrets; print(secrets.token_hex(32))"
VIBEMATCH_SECRET_KEY=change-me-dev-only
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Prod example: VIBEMATCH_CORS_ORIGINS=https://vibematch.app,https://www.vibematch.app
VIBEMATCH_CORS_ORIGINS=*
# Prod example: VIBEMATCH_TRUSTED_HOSTS=api.vibematch.app
VIBEMATCH_TRUSTED_HOSTS=*
LASTFM_API_KEY=
# Dev: sqlite:///./vibematch.db
# Prod: postgresql+psycopg://user:password@host:5432/vibematch
DATABASE_URL=sqlite:///./vibematch.db
LOG_LEVEL=INFO
